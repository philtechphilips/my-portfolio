# X (Twitter) API Configuration
# NOT required for the video section — real videos are fetched from X's public
# syndication endpoint. Just paste your post URLs into app/data/xVideos.ts.
#
# Only needed if you want new video posts to appear automatically without
# editing that file. As of Feb 2026 X bills reads pay-per-use (~$0.005/post
# read, ~$0.010/user read) and there is no free read tier, so this is opt-in.
# Get a token at https://developer.twitter.com/
X_BEARER_TOKEN=your_bearer_token_here

# Set to true to auto-discover your video posts via the paid X v2 API.
# Leave unset/false to stay on the free syndication path.
X_AUTO_DISCOVER=false

# Optional. Leave unset and the app resolves your ID from the handle in
# app/data/xVideos.ts (cached 7 days). Setting it saves one billable user read.
# NEXT_PUBLIC_TWITTER_ID=

# GitHub Personal Access Token (for rate-limit free GitHub API access)
GITHUB_TOKEN=your_github_personal_access_token_here

